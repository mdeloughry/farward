#!/usr/bin/env bash

set -Euo pipefail

PROGRAM_NAME="$(basename "$0")"
FARWARD_VERSION="0.1.0"
DEFAULT_HOST="${FARWARD_HOST:-${DOCKPORT_HOST:-${SAIL_PORTS_HOST:-dev-box}}}"
SSH_HOST="$DEFAULT_HOST"
LOCAL_BIND_HOST="${FARWARD_BIND_HOST:-localhost}"
TARGET_HOST="${FARWARD_TARGET_HOST:-localhost}"
TARGET_HOST_EXPLICIT=false
BACKGROUND=false
OPEN_BROWSER=false
DIAGNOSE=false
DRY_RUN=false
SELF_TEST=false
DISCOVER_DOCKER=true
MANUAL_ONLY=false
MANUAL_SPECS=()
SCAN=false
SCAN_FLAG=false
NO_SCAN=false
EXCLUDE_PORTS="|"
ssh_common_args=()
SSH_PID=""
SSH_LOG=""
DASHBOARD_ACTIVE=false
COMMAND_BUFFER=""
FRAME=0
ORIG_TTY_SETTINGS=""
DASHBOARD_TTY_POLL=false
SESSION_DIR_PENDING=false
SESSION_DIR=""
SESSION_RESOLVED=""
SSH_LOG_PERSIST=false
MANAGED_PID=""
SUPERVISOR_SSH_PID=""
SUPERVISOR_DIR=""
RETRY_LIMIT=3
RETRY_FLAG=false

usage() {
    cat <<USAGE
Usage: $PROGRAM_NAME [options] [ssh-host]

Interactively select published Docker ports or enter arbitrary remote TCP ports
and forward them securely through SSH to your local computer.

Options:
  -p, --port SPEC      Add a manual remote port. SPEC may be REMOTE or REMOTE:LOCAL
                       Repeat this option to forward several standalone services
  -t, --target-host HOST
                       Remote-side host to connect to (default: $TARGET_HOST)
  -m, --manual         Skip Docker discovery and prompt for manual ports
      --no-docker      Do not inspect Docker; use only ports supplied with --port
      --scan           Also list every TCP port listening on the remote host
      --listeners      Alias for --scan
      --no-scan        Never scan remote listeners, including the automatic fallback
      --exclude PORT   Hide a remote port from Docker/scan results; repeatable
  -b, --background     Start the SSH tunnel in the background, without dashboard
  -o, --open           Open recognised HTTP services in the default browser
      --retry N        Reconnect a background tunnel up to N times after a drop
                       (0 disables; default 3)
      --retry-forever  Keep reconnecting a background tunnel indefinitely
      --diagnose       Check remote target reachability and exit without tunneling
      --dry-run        Print resolved forwards and SSH arguments without tunneling
      --self-test      Run Farward's local smoke test and exit
  -v, --version        Print the Farward version and exit
  -h, --help           Show this help

Dashboard controls:
  :q                   Stop every tunnel started by this session and exit
  Ctrl+C               Stop every tunnel started by this session and exit

Session commands:
  $PROGRAM_NAME list                       List background tunnels
  $PROGRAM_NAME logs ID [-f]               Show (or follow) a tunnel's SSH log
  $PROGRAM_NAME restart ID                 Restart a tunnel with saved forwards
  $PROGRAM_NAME stop ID                    Stop one background tunnel
  $PROGRAM_NAME stop --all                 Stop every background tunnel

Background sessions reconnect automatically (default 3 attempts).
Use --retry N or --retry-forever to change the budget.

Environment:
  FARWARD_HOST         Default SSH host (defaults to: dev-box)
  FARWARD_BIND_HOST    Local bind address for forwarded ports (defaults to: localhost)
  FARWARD_SSH_CONFIG   Optional ssh_config file to pass to ssh with -F
  FARWARD_TARGET_HOST  Remote-side target host for forwards (defaults to: localhost)
  FARWARD_STATE_DIR    Background session state directory
  DOCKPORT_HOST        Legacy fallback for compatibility
  SAIL_PORTS_HOST      Legacy fallback for compatibility

Examples:
  $PROGRAM_NAME help
  $PROGRAM_NAME my-dev-box
  $PROGRAM_NAME --open user@docker-host
  $PROGRAM_NAME --background prod-tools
  $PROGRAM_NAME list
  $PROGRAM_NAME logs 20261027-143012-4412-a1b2
  $PROGRAM_NAME restart 20261027
  $PROGRAM_NAME stop --all
  $PROGRAM_NAME --port 8347 user@remote-host
  $PROGRAM_NAME --port 3000:13000 --port 8025 user@remote-host
  $PROGRAM_NAME --manual user@remote-host
USAGE
}

fail() {
    printf 'Error: %b\n' "$*" >&2
    exit 1
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

ssh_command() {
    if ((${#ssh_common_args[@]} > 0)); then
        # The remote command is expanded by the remote shell on purpose.
        # shellcheck disable=SC2029
        ssh "${ssh_common_args[@]}" "$@"
    else
        # shellcheck disable=SC2029
        ssh "$@"
    fi
}

script_path() {
    local dir

    if [[ "$0" == */* ]]; then
        dir="$(cd "$(dirname "$0")" && pwd -P)"
        printf '%s/%s\n' "$dir" "$(basename "$0")"
    else
        command -v "$0"
    fi
}

run_self_test() {
    local self smoke_script data_home

    self="$(script_path)"
    data_home="${XDG_DATA_HOME:-$HOME/.local/share}"

    if [[ -n "${FARWARD_SMOKE_TEST:-}" ]]; then
        smoke_script="$FARWARD_SMOKE_TEST"
    elif [[ -x "$(dirname "$self")/tests/smoke.sh" ]]; then
        smoke_script="$(dirname "$self")/tests/smoke.sh"
    elif [[ -x "$data_home/farward/smoke.sh" ]]; then
        smoke_script="$data_home/farward/smoke.sh"
    else
        fail "Could not find Farward smoke test. Reinstall with ./install.sh or set FARWARD_SMOKE_TEST."
    fi

    FARWARD_BIN="$self" "$smoke_script"
}

is_port_available() {
    local port="$1"

    if command_exists lsof; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 && return 1
    elif command_exists ss; then
        ss -ltn "sport = :$port" 2>/dev/null | grep -q LISTEN && return 1
    elif command_exists netstat; then
        netstat -an 2>/dev/null | grep -Eq "[.:]${port}[[:space:]].*LISTEN" && return 1
    fi
    return 0
}

preferred_local_port() {
    local remote_port="$1"

    case "$remote_port" in
        80)  printf '8080\n' ;;
        443) printf '8443\n' ;;
        *)
            if (( remote_port < 1024 )); then
                printf '%s\n' "$((remote_port + 8000))"
            else
                printf '%s\n' "$remote_port"
            fi
            ;;
    esac
}

next_available_port() {
    local port="$1"
    while ! is_port_available "$port"; do
        port=$((port + 1))
        if (( port > 65535 )); then
            fail "Could not find an available local port."
        fi
    done
    printf '%s\n' "$port"
}

open_url() {
    local url="$1"
    if command_exists open; then
        open "$url" >/dev/null 2>&1 || true
    elif command_exists xdg-open; then
        xdg-open "$url" >/dev/null 2>&1 || true
    fi
}

# shellcheck disable=SC2329 # invoked by trap
cleanup() {
    local exit_code=$?
    trap - EXIT INT TERM HUP

    if [[ -n "${SSH_PID:-}" ]] && kill -0 "$SSH_PID" 2>/dev/null; then
        kill "$SSH_PID" 2>/dev/null || true
        wait "$SSH_PID" 2>/dev/null || true
    fi

    if [[ -n "${MANAGED_PID:-}" ]] && kill -0 "$MANAGED_PID" 2>/dev/null; then
        kill "$MANAGED_PID" 2>/dev/null || true
        wait "$MANAGED_PID" 2>/dev/null || true
    fi

    if [[ "$DASHBOARD_ACTIVE" == true ]]; then
        restore_dashboard_tty
        printf '\033[?2026l\033[?7h\033[?25h\033[?1049l'
    fi

    if [[ "$SESSION_DIR_PENDING" == true && -n "$SESSION_DIR" ]]; then
        rm -rf "$SESSION_DIR" 2>/dev/null || true
    fi

    if [[ "$SSH_LOG_PERSIST" != true && -n "${SSH_LOG:-}" ]]; then
        rm -f "$SSH_LOG" 2>/dev/null || true
    fi

    exit "$exit_code"
}

setup_dashboard_tty() {
    local tty_settings=""

    DASHBOARD_TTY_POLL=false
    [[ -r /dev/tty ]] || return 0

    tty_settings="$(stty -g </dev/tty 2>/dev/null || true)"
    [[ -n "$tty_settings" ]] || return 0

    # Bash 3.2 only accepts whole seconds for read -t. Terminal min/time gives
    # us a nonblocking single-character read while sleep controls frame rate.
    if stty -echo -icanon min 0 time 0 </dev/tty 2>/dev/null; then
        ORIG_TTY_SETTINGS="$tty_settings"
        DASHBOARD_TTY_POLL=true
    fi
}

restore_dashboard_tty() {
    DASHBOARD_TTY_POLL=false
    [[ -n "${ORIG_TTY_SETTINGS:-}" ]] || return 0

    stty "$ORIG_TTY_SETTINGS" </dev/tty 2>/dev/null || true
    ORIG_TTY_SETTINGS=""
}

handle_dashboard_key() {
    local key="$1"

    case "$key" in
        ""|$'\n'|$'\r')
            if [[ "$COMMAND_BUFFER" == ":q" || "$COMMAND_BUFFER" == "q" ]]; then
                shutdown_cleanly
            fi
            COMMAND_BUFFER=""
            ;;
        $'\177'|$'\b')
            COMMAND_BUFFER="${COMMAND_BUFFER%?}"
            ;;
        *)
            if [[ "$key" =~ [[:print:]] ]]; then
                COMMAND_BUFFER="${COMMAND_BUFFER}${key}"
                COMMAND_BUFFER="${COMMAND_BUFFER:0:32}"
            fi
            ;;
    esac
}

shutdown_cleanly() {
    trap - EXIT
    if [[ -n "${SSH_PID:-}" ]] && kill -0 "$SSH_PID" 2>/dev/null; then
        kill "$SSH_PID" 2>/dev/null || true
        wait "$SSH_PID" 2>/dev/null || true
    fi
    if [[ "$DASHBOARD_ACTIVE" == true ]]; then
        restore_dashboard_tty
        printf '\033[?2026l\033[?7h\033[?25h\033[?1049l'
    fi
    exit 0
}

terminal_size() {
    SCREEN_ROWS="$(tput lines 2>/dev/null || printf '24')"
    SCREEN_COLS="$(tput cols 2>/dev/null || printf '80')"
    (( SCREEN_ROWS < 8 )) && SCREEN_ROWS=8
    (( SCREEN_COLS < 20 )) && SCREEN_COLS=20
}

put_text() {
    local row="$1"
    local col="$2"
    local text="$3"
    local max_len

    (( row >= 0 && row < SCREEN_ROWS )) || return 0
    (( col >= 0 && col < SCREEN_COLS )) || return 0

    max_len=$((SCREEN_COLS - col))
    text="${text:0:max_len}"
    SCREEN_LINES[row]="${SCREEN_LINES[row]:0:col}${text}${SCREEN_LINES[row]:col+${#text}}"
}

make_border() {
    local width="$1"
    local result=""
    printf -v result '%*s' "$width" ''
    printf '%s' "${result// /-}"
}

render_dashboard_frame() {
    local row col i item local_side remote_side
    local panel_width panel_height panel_left panel_top inner_width
    local border title status command_line max_forwards visible_forwards
    local star_count x y glyph line panel_blank output=""

    terminal_size

    SCREEN_LINES=()
    printf -v line '%*s' "$SCREEN_COLS" ''
    for ((row=0; row<SCREEN_ROWS; row++)); do
        SCREEN_LINES+=("$line")
    done

    # Sparse moving star field across the entire terminal.
    star_count=$((SCREEN_ROWS * SCREEN_COLS / 90))
    (( star_count < 24 )) && star_count=24
    for ((i=0; i<star_count; i++)); do
        x=$(((i * 47 + FRAME * (1 + i % 3)) % SCREEN_COLS))
        y=$(((i * 29 + FRAME / (2 + i % 4)) % SCREEN_ROWS))
        case $(((i + FRAME / 3) % 11)) in
            0) glyph='*' ;;
            1|2) glyph='+' ;;
            *) glyph='.' ;;
        esac
        put_text "$y" "$x" "$glyph"
    done

    panel_width=$((SCREEN_COLS - 6))
    (( panel_width > 92 )) && panel_width=92
    (( panel_width < 38 )) && panel_width=$((SCREEN_COLS - 2))

    max_forwards=$((SCREEN_ROWS - 12))
    (( max_forwards < 1 )) && max_forwards=1
    visible_forwards=${#summary[@]}
    (( visible_forwards > max_forwards )) && visible_forwards=$max_forwards

    panel_height=$((visible_forwards + 9))
    (( panel_height > SCREEN_ROWS - 2 )) && panel_height=$((SCREEN_ROWS - 2))
    panel_left=$(((SCREEN_COLS - panel_width) / 2))
    panel_top=$(((SCREEN_ROWS - panel_height) / 2))
    (( panel_top < 1 )) && panel_top=1
    inner_width=$((panel_width - 2))
    border="$(make_border "$inner_width")"
    printf -v panel_blank '%*s' "$panel_width" ''

    for ((row=0; row<panel_height; row++)); do
        put_text "$((panel_top + row))" "$panel_left" "$panel_blank"
    done

    put_text "$panel_top" "$panel_left" "+${border}+"
    for ((row=1; row<panel_height-1; row++)); do
        put_text "$((panel_top + row))" "$panel_left" "|"
        put_text "$((panel_top + row))" "$((panel_left + panel_width - 1))" "|"
    done
    put_text "$((panel_top + panel_height - 1))" "$panel_left" "+${border}+"

    title=" FARWARD "
    put_text "$panel_top" "$((panel_left + 3))" "$title"
    put_text "$((panel_top + 2))" "$((panel_left + 3))" "Host: $SSH_HOST"
    status="Status: connected   SSH PID: $SSH_PID"
    put_text "$((panel_top + 3))" "$((panel_left + 3))" "$status"
    put_text "$((panel_top + 5))" "$((panel_left + 3))" "ACTIVE FORWARDS"

    row=$((panel_top + 6))
    for ((i=0; i<visible_forwards; i++)); do
        item="${summary[$i]}"
        local_side="${item%%|*}"
        remote_side="${item#*|}"
        put_text "$row" "$((panel_left + 4))" "> ${local_side} -> ${remote_side}"
        row=$((row + 1))
    done
    if (( ${#summary[@]} > visible_forwards )); then
        put_text "$((row - 1))" "$((panel_left + 4))" "... and $((${#summary[@]} - visible_forwards + 1)) more"
    fi

    command_line="Command: ${COMMAND_BUFFER}"
    put_text "$((panel_top + panel_height - 3))" "$((panel_left + 3))" "Type :q then Enter to stop all tunnels (or press q then Enter)"
    put_text "$((panel_top + panel_height - 2))" "$((panel_left + 3))" "$command_line"

    for ((row=0; row<SCREEN_ROWS; row++)); do
        output+="${SCREEN_LINES[$row]}"
        (( row < SCREEN_ROWS - 1 )) && output+=$'\n'
    done

    # Synchronized output prevents partially drawn frames in terminals that support it.
    printf '\033[?2026h\033[H%s\033[?2026l' "$output"
}

run_dashboard_python() {
    python3 - "$SSH_PID" "$SSH_HOST" "${summary[@]}" <<'PY'
import os
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

pid = int(sys.argv[1])
ssh_host = sys.argv[2]
summary = sys.argv[3:]
command = ""
frame = 0
tty_file = None
tty_fd = None
old_term = None


def ssh_alive():
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        result = subprocess.run(
            ["ps", "-p", str(pid), "-o", "stat="],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return True

    if result.returncode != 0:
        return False
    return not result.stdout.strip().startswith("Z")


def put_text(lines, row, col, text):
    rows = len(lines)
    cols = len(lines[0]) if rows else 0
    if row < 0 or row >= rows or col < 0 or col >= cols:
        return
    text = text[: cols - col]
    for index, char in enumerate(text):
        lines[row][col + index] = char


def render():
    cols, rows = shutil.get_terminal_size((80, 24))
    rows = max(rows, 8)
    cols = max(cols, 20)
    lines = [[" "] * cols for _ in range(rows)]

    star_count = max(rows * cols // 90, 24)
    for i in range(star_count):
        x = (i * 47 + frame * (1 + i % 3)) % cols
        y = (i * 29 + frame // (2 + i % 4)) % rows
        phase = (i + frame // 3) % 11
        glyph = "*" if phase == 0 else "+" if phase in (1, 2) else "."
        put_text(lines, y, x, glyph)

    panel_width = cols - 6
    if panel_width > 92:
        panel_width = 92
    if panel_width < 38:
        panel_width = cols - 2

    max_forwards = max(rows - 12, 1)
    visible = min(len(summary), max_forwards)
    panel_height = min(visible + 9, rows - 2)
    panel_left = max((cols - panel_width) // 2, 0)
    panel_top = max((rows - panel_height) // 2, 1)
    inner_width = max(panel_width - 2, 1)
    border = "-" * inner_width

    for row in range(panel_height):
        put_text(lines, panel_top + row, panel_left, " " * panel_width)

    put_text(lines, panel_top, panel_left, "+" + border + "+")
    for row in range(1, max(panel_height - 1, 1)):
        put_text(lines, panel_top + row, panel_left, "|")
        put_text(lines, panel_top + row, panel_left + panel_width - 1, "|")
    put_text(lines, panel_top + panel_height - 1, panel_left, "+" + border + "+")

    put_text(lines, panel_top, panel_left + 3, " FARWARD ")
    put_text(lines, panel_top + 2, panel_left + 3, "Host: " + ssh_host)
    put_text(lines, panel_top + 3, panel_left + 3, "Status: connected   SSH PID: " + str(pid))
    put_text(lines, panel_top + 5, panel_left + 3, "ACTIVE FORWARDS")

    row = panel_top + 6
    for item in summary[:visible]:
        local_side, _, remote_side = item.partition("|")
        put_text(lines, row, panel_left + 4, "> " + local_side + " -> " + remote_side)
        row += 1
    if len(summary) > visible:
        put_text(lines, row - 1, panel_left + 4, "... and " + str(len(summary) - visible + 1) + " more")

    put_text(lines, panel_top + panel_height - 3, panel_left + 3, "Type :q then Enter to stop all tunnels")
    put_text(lines, panel_top + panel_height - 2, panel_left + 3, "Command: " + command)

    output = "\n".join("".join(line) for line in lines)
    sys.stdout.write("\033[?2026h\033[H" + output + "\033[?2026l")
    sys.stdout.flush()


try:
    tty_file = open("/dev/tty", "rb", buffering=0)
    tty_fd = tty_file.fileno()
    old_term = termios.tcgetattr(tty_fd)
    tty.setcbreak(tty_fd)

    sys.stdout.write("\033[?1049h\033[2J\033[H\033[?25l\033[?7l")
    sys.stdout.flush()

    while ssh_alive():
        render()

        while select.select([tty_fd], [], [], 0)[0]:
            data = os.read(tty_fd, 32)
            if not data:
                break

            for char in data.decode(errors="ignore"):
                if char in ("\r", "\n"):
                    if command in (":q", "q"):
                        try:
                            os.kill(pid, signal.SIGTERM)
                        except OSError:
                            pass
                        raise SystemExit(2)
                    command = ""
                elif char in ("\x7f", "\b"):
                    command = command[:-1]
                elif char.isprintable():
                    command = (command + char)[:32]

        frame += 1
        time.sleep(0.12)

    raise SystemExit(3)
finally:
    if old_term is not None:
        try:
            termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_term)
        except termios.error:
            pass
    if tty_file is not None:
        tty_file.close()
    sys.stdout.write("\033[?2026l\033[?7h\033[?25h\033[?1049l")
    sys.stdout.flush()
PY
}

run_dashboard_bash() {
    local key=""
    DASHBOARD_ACTIVE=true
    printf '\033[?1049h\033[2J\033[H\033[?25l\033[?7l'
    setup_dashboard_tty

    while kill -0 "$SSH_PID" 2>/dev/null; do
        render_dashboard_frame
        key=""

        if [[ "$DASHBOARD_TTY_POLL" == true ]]; then
            while IFS= read -rsn1 key </dev/tty; do
                [[ -n "$key" ]] || break
                handle_dashboard_key "$key"
            done
        fi

        FRAME=$((FRAME + 1))
        sleep 0.12
    done

    wait "$SSH_PID" || true
    restore_dashboard_tty
    printf '\033[?2026l\033[?7h\033[?25h\033[?1049l'
    DASHBOARD_ACTIVE=false
    local ssh_error=""
    if [[ -n "${SSH_LOG:-}" && -s "$SSH_LOG" ]]; then
        ssh_error="$(cat "$SSH_LOG")"
    fi
    if [[ -n "$ssh_error" ]]; then
        fail "The SSH tunnel closed unexpectedly:
$ssh_error"
    fi
    fail "The SSH tunnel closed unexpectedly."
}

run_dashboard() {
    local dashboard_status=0

    if command_exists python3; then
        DASHBOARD_ACTIVE=true
        set +e
        run_dashboard_python
        dashboard_status=$?
        set -e
        DASHBOARD_ACTIVE=false

        if (( dashboard_status == 2 )); then
            shutdown_cleanly
        fi

        if (( dashboard_status != 3 )) && [[ -n "${SSH_PID:-}" ]] && kill -0 "$SSH_PID" 2>/dev/null; then
            kill "$SSH_PID" 2>/dev/null || true
            wait "$SSH_PID" 2>/dev/null || true
            fail "The dashboard exited unexpectedly; the SSH tunnel was stopped."
        fi

        wait "$SSH_PID" || true
        local ssh_error=""
        if [[ -n "${SSH_LOG:-}" && -s "$SSH_LOG" ]]; then
            ssh_error="$(cat "$SSH_LOG")"
        fi
        if [[ -n "$ssh_error" ]]; then
            fail "The SSH tunnel closed unexpectedly:
$ssh_error"
        fi
        fail "The SSH tunnel closed unexpectedly."
    fi

    run_dashboard_bash
}

validate_port_number() {
    local port="$1"
    [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 ))
}

validate_target_host() {
    local host="$1"
    [[ "$host" =~ ^[A-Za-z0-9._-]+$ ]]
}

validate_bind_host() {
    local host="$1"
    [[ "$host" == "localhost" || "$host" =~ ^[0-9]+(\.[0-9]+){3}$ ]]
}

diagnose_remote_target() {
    local target_host="$1"
    local remote_port="$2"
    local remote_command
    local output

    remote_command="host=$target_host; port=$remote_port; py='import socket,sys; socket.create_connection((sys.argv[1], int(sys.argv[2])), 3).close()'; if command -v python3 >/dev/null 2>&1; then python3 -c \"\$py\" \"\$host\" \"\$port\"; elif command -v python >/dev/null 2>&1; then python -c \"\$py\" \"\$host\" \"\$port\"; elif command -v nc >/dev/null 2>&1; then nc -z -w 3 \"\$host\" \"\$port\" 2>/dev/null || nc -z -G 3 \"\$host\" \"\$port\" 2>/dev/null; elif command -v timeout >/dev/null 2>&1 && command -v bash >/dev/null 2>&1; then timeout 3 bash -c ':</dev/tcp/\$1/\$2' -- \"\$host\" \"\$port\"; else echo 'remote host has no supported TCP probe tool for diagnosis (python3, python, nc with timeout, or timeout+bash)' >&2; exit 127; fi"

    printf 'Checking remote reachability: %s -> %s:%s ... ' "$SSH_HOST" "$target_host" "$remote_port"
    if output="$(ssh_command -o BatchMode=yes -o ConnectTimeout=8 "$SSH_HOST" "$remote_command" 2>&1)"; then
        printf 'ok\n'
        return 0
    fi

    printf 'failed\n'
    if [[ -n "$output" ]]; then
        printf '%s\n' "$output" >&2
    fi
    return 1
}

forward_target_error_pattern() {
    printf '%s\n' 'open failed|connect failed|connection refused|administratively prohibited|name or service not known|no route to host|network is unreachable'
}

fail_forward_target() {
    local local_port="$1"
    local target_host="$2"
    local remote_port="$3"

    fail "SSH could not connect from $SSH_HOST to $target_host:$remote_port for local port $local_port.
$(cat "$SSH_LOG")

If the service is not bound to remote localhost, retry with --target-host HOST."
}

has_forward_target_error() {
    local offset="${1:-0}"

    [[ -s "$SSH_LOG" ]] && tail -n "+$((offset + 1))" "$SSH_LOG" |
        grep -Eiq "$(forward_target_error_pattern)"
}

can_connect_local() {
    local host="$1"
    local port="$2"

    if command_exists python3; then
        python3 - "$host" "$port" <<'PY'
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
try:
    with socket.create_connection((host, port), 0.5):
        pass
except OSError:
    raise SystemExit(1)
PY
        return $?
    fi

    if command_exists nc; then
        nc -z -w 1 "$host" "$port" >/dev/null 2>&1 ||
            nc -z -G 1 "$host" "$port" >/dev/null 2>&1
        return $?
    fi

    return 2
}

probe_forward_target() {
    local local_port="$1"
    local bind_host="$2"
    local target_host="$3"
    local remote_port="$4"
    local deadline
    local listener_seen=false
    local log_offset=0

    command_exists python3 || command_exists nc || return 0

    if [[ "$SSH_LOG_PERSIST" == true ]]; then
        log_offset="$(wc -l <"$SSH_LOG" 2>/dev/null | tr -d ' ' || true)"
        [[ -n "$log_offset" ]] || log_offset=0
    else
        : >"$SSH_LOG"
    fi
    deadline=$((SECONDS + 3))
    while (( SECONDS <= deadline )); do
        if can_connect_local "$bind_host" "$local_port"; then
            listener_seen=true
        fi
        sleep 0.2

        if has_forward_target_error "$log_offset"; then
            fail_forward_target "$local_port" "$target_host" "$remote_port"
        fi

        # Once a probe has reached the local listener without an SSH channel
        # error, watch briefly for remote-side channel failures before handoff.
        if [[ "$listener_seen" == true ]] && can_connect_local "$bind_host" "$local_port"; then
            sleep 1
            if has_forward_target_error "$log_offset"; then
                fail_forward_target "$local_port" "$target_host" "$remote_port"
            fi
            return 0
        fi
    done

    fail "SSH did not open local port $local_port for $target_host:$remote_port."
}

prompt_manual_port() {
    local remote_port="" local_port="" entered=""

    while true; do
        printf 'Remote TCP port (1-65535, blank to finish): ' >/dev/tty
        IFS= read -r entered </dev/tty || return 1
        [[ -z "$entered" ]] && return 1
        if validate_port_number "$entered"; then
            remote_port="$entered"
            break
        fi
        printf 'Port "%s" is invalid. TCP ports must be between 1 and 65535.\n' "$entered" >/dev/tty
    done

    printf '%s\t%s\tmanual\ttcp\n' "manual:$remote_port" "$remote_port"
}

parse_manual_spec() {
    local spec="$1" remote localp
    if [[ "$spec" == *:* ]]; then
        remote="${spec%%:*}"
        localp="${spec#*:}"
    else
        remote="$spec"
        localp=""
    fi
    validate_port_number "$remote" || fail "Remote port '$remote' is invalid; use a number from 1 to 65535."
    if [[ -n "$localp" ]]; then
        validate_port_number "$localp" || fail "Local port '$localp' is invalid; use a number from 1 to 65535."
    fi
    printf '%s\t%s\tmanual\ttcp\t%s\n' "manual:$remote" "$remote" "$localp"
}

format_manual_row() {
    local label="$1" remote_port="$2" local_override="${3:-}"
    [[ -n "$local_override" ]] || local_override="__AUTO__"
    printf '%-30s remote:%-6s standalone TCP\t%s\tmanual\ttcp\t%s\t__DEFAULT__' "$label" "$remote_port" "$remote_port" "$local_override"
}

format_add_manual_row() {
    printf '%-30s %s\t%s\t%s\t%s\t__AUTO__\t__DEFAULT__' '[add custom port]' 'enter an arbitrary remote TCP port' '__ADD_MANUAL__' 'manual' 'tcp'
}

append_selection_row() {
    local row="$1"
    if [[ -n "$selection_rows" && "$selection_rows" != *$'\n' ]]; then
        selection_rows+=$'\n'
    fi
    selection_rows+="$row"$'\n'
}

scan_remote_listeners() {
    local remote_command

    remote_command='printf "@@FARWARD_SCAN_BEGIN@@\n"
if command -v ss >/dev/null 2>&1; then
    printf "@@FARWARD_SCAN_TOOL:ss@@\n"
    ss -ltnp 2>/dev/null || ss -ltn
elif command -v lsof >/dev/null 2>&1; then
    printf "@@FARWARD_SCAN_TOOL:lsof@@\n"
    lsof -nP -iTCP -sTCP:LISTEN -F pcn 2>/dev/null
elif command -v netstat >/dev/null 2>&1; then
    printf "@@FARWARD_SCAN_TOOL:netstat@@\n"
    netstat -ltnp 2>/dev/null || netstat -ltn
else
    exit 127
fi'

    ssh_command -o BatchMode=yes -o ConnectTimeout=8 "$SSH_HOST" "$remote_command"
}

# Normalises ss, lsof -F pcn and netstat output into "process<TAB>target<TAB>port".
# Written for POSIX awk so the same program works with BSD awk and mawk.
normalize_scan_output() {
    LC_ALL=C awk '
    function parse_local(hostport,   close_at, last_colon, k, host, port) {
        NORM_TARGET = ""
        NORM_PORT = ""
        if (substr(hostport, 1, 1) == "[") {
            close_at = index(hostport, "]")
            if (close_at == 0) return 0
            host = substr(hostport, 2, close_at - 2)
            port = substr(hostport, close_at + 2)
        } else {
            last_colon = 0
            for (k = length(hostport); k > 0; k--) {
                if (substr(hostport, k, 1) == ":") {
                    last_colon = k
                    break
                }
            }
            if (last_colon == 0) return 0
            host = substr(hostport, 1, last_colon - 1)
            port = substr(hostport, last_colon + 1)
        }
        sub(/%[^%]*$/, "", host)
        if (port !~ /^[0-9]+$/) return 0
        if (port + 0 < 1 || port + 0 > 65535) return 0
        NORM_PORT = port + 0
        if (host == "" || host == "*" || host == "0.0.0.0" || host == "::" || host == ":::") {
            NORM_TARGET = "localhost"
        } else if (host == "127.0.0.1" || host == "::1") {
            NORM_TARGET = "localhost"
        } else if (host ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
            NORM_TARGET = host
        } else {
            NORM_TARGET = "skip"
        }
        return 1
    }
    function emit(name, hostport) {
        if (!parse_local(hostport)) return
        if (NORM_TARGET == "skip") {
            skipped++
            return
        }
        if (name == "") name = "?"
        printf "%s\t%s\t%s\n", name, NORM_TARGET, NORM_PORT
    }
    BEGIN {
        tool = ""
        process = "?"
        skipped = 0
    }
    /^@@FARWARD_SCAN_BEGIN@@/ { next }
    /^@@FARWARD_SCAN_TOOL:/ {
        tool = $0
        sub(/^@@FARWARD_SCAN_TOOL:/, "", tool)
        sub(/@@$/, "", tool)
        next
    }
    tool == "lsof" {
        if (substr($0, 1, 1) == "p") { process = "?"; next }
        if (substr($0, 1, 1) == "c") { process = substr($0, 2); next }
        if (substr($0, 1, 1) == "n") { emit(process, substr($0, 2)); next }
        next
    }
    tool == "netstat" {
        if ($1 ~ /^tcp/ && $6 == "LISTEN") {
            program = $7
            if (program == "" || program == "-") {
                program = "?"
            } else {
                sub(/^[0-9]+\//, "", program)
            }
            emit(program, $4)
        }
        next
    }
    tool == "ss" {
        if ($1 == "LISTEN") {
            process = "?"
            users_at = index($0, "users:((")
            if (users_at > 0) {
                rest = substr($0, users_at + 9)
                split(rest, quoted, "\"")
                if (quoted[1] != "") process = quoted[1]
            }
            emit(process, $4)
        }
        next
    }
    { next }
    END { printf "@@FARWARD_SCAN_SKIPPED@@\t%d\n", skipped }
    '
}

append_scan_rows() {
    local scan_status scan_output scan_raw scan_skipped scan_normalized scan_added
    local scan_proc scan_target scan_port scan_target_note scan_row
    local _seen_display _seen_remote _seen_container _seen_protocol _seen_local _seen_target
    local seen_listen_ports

    scan_status=0
    scan_output=""
    if scan_output="$(scan_remote_listeners 2>&1)"; then
        scan_status=0
    else
        scan_status=$?
    fi

    if (( scan_status == 127 )); then
        printf 'Remote listener scan unavailable (no ss, lsof, or netstat on %s); continuing without it.\n' "$SSH_HOST" >&2
    elif (( scan_status != 0 )); then
        printf 'Remote listener scan failed on %s: %s\n' "$SSH_HOST" "$(printf '%s' "$scan_output" | head -n 1)" >&2
    fi

    scan_raw="$(printf '%s\n' "$scan_output" | normalize_scan_output)"
    scan_skipped="$(printf '%s\n' "$scan_raw" | awk -F'\t' '$1 == "@@FARWARD_SCAN_SKIPPED@@" { total += $2 } END { print total + 0 }')"

    # Docker wins on a port match: a published mapping and its docker-proxy
    # listener (usually 0.0.0.0) describe the same service but normalise to
    # different target hosts, so compare on the remote port alone.
    seen_listen_ports="|"
    if [[ -n "$selection_rows" ]]; then
        while IFS=$'\t' read -r _seen_display _seen_remote _seen_container _seen_protocol _seen_local _seen_target; do
            [[ -n "$_seen_remote" ]] || continue
            seen_listen_ports+="${_seen_remote}|"
        done <<< "$selection_rows"
    fi

    # Sort by port, then bind, with named processes ahead of "?" so dedupe keeps
    # the informative row.
    scan_normalized="$(
        printf '%s\n' "$scan_raw" |
            LC_ALL=C sort -t $'\t' -k3,3n -k2,2 -k1,1r |
            LC_ALL=C awk -F'\t' 'NF >= 3 && !seen[$2 ":" $3]++'
    )"

    scan_added=0
    while IFS=$'\t' read -r scan_proc scan_target scan_port; do
        [[ -n "${scan_proc}${scan_target}${scan_port}" ]] || continue
        [[ "$EXCLUDE_PORTS" == *"|${scan_port}|"* ]] && continue
        if [[ "$seen_listen_ports" == *"|${scan_port}|"* ]]; then
            continue
        fi
        seen_listen_ports+="${scan_port}|"

        scan_proc="${scan_proc:0:28}"
        scan_target_note=""
        [[ "$scan_target" != "localhost" ]] && scan_target_note=" bind:${scan_target}"
        printf -v scan_row 'L %-28s host:%-6s listener     %s%s\t%s\t%s\t%s\t__AUTO__\t%s' \
            "$scan_proc" "$scan_port" "tcp" "$scan_target_note" \
            "$scan_port" "$scan_port" "tcp" "$scan_target"
        append_selection_row "$scan_row"
        scan_added=$((scan_added + 1))
    done <<< "$scan_normalized"

    if (( scan_skipped > 0 )); then
        printf 'Skipped %s IPv6-only listener(s); only IPv4 targets are supported yet.\n' "$scan_skipped" >&2
    fi
    if (( scan_added == 0 )); then
        printf 'No remote listeners found.\n'
    fi
}

trap cleanup EXIT INT TERM HUP

farward_state_root() {
    local base

    if [[ -n "${FARWARD_STATE_DIR:-}" ]]; then
        base="$FARWARD_STATE_DIR"
    else
        base="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/farward"
    fi
    while [[ "$base" == */ && "$base" != "/" ]]; do
        base="${base%/}"
    done
    printf '%s\n' "$base"
}

new_session_id() {
    printf '%s-%s-%04x\n' "$(date +%Y%m%d-%H%M%S)" "$$" "$RANDOM"
}

load_session_meta() {
    local meta="$1" key value

    SESSION_PID=""
    SESSION_SSH_PID=""
    SESSION_HOST=""
    SESSION_STARTED=""
    SESSION_BIND=""
    SESSION_RETRIES="3"
    [[ -r "$meta" ]] || return 1

    while IFS='=' read -r key value; do
        case "$key" in
            pid) SESSION_PID="$value" ;;
            ssh_pid) SESSION_SSH_PID="$value" ;;
            host) SESSION_HOST="$value" ;;
            started) SESSION_STARTED="$value" ;;
            bind) SESSION_BIND="$value" ;;
            retries) SESSION_RETRIES="$value" ;;
        esac
    done < "$meta"

    [[ -n "$SESSION_HOST" ]]
}

write_session_meta() {
    local dir="$1" id="$2" pid="$3" host="$4" bind="$5" retries="$6" ssh_pid="${7:-}"
    local started

    started="$(sed -n 's/^started=//p' "$dir/meta" 2>/dev/null | head -n 1 || true)"
    [[ "$started" =~ ^[0-9]+$ ]] || started="$(date +%s)"

    {
        printf 'id=%s\n' "$id"
        printf 'pid=%s\n' "$pid"
        printf 'ssh_pid=%s\n' "$ssh_pid"
        printf 'host=%s\n' "$host"
        printf 'started=%s\n' "$started"
        printf 'bind=%s\n' "$bind"
        printf 'retries=%s\n' "$retries"
        printf 'version=2\n'
    } > "$dir/meta"
    chmod 600 "$dir/meta" 2>/dev/null || true
}

update_meta_field() {
    local dir="$1"
    local key="$2"
    local value="$3"
    local tmp="$dir/meta.tmp"

    awk -F'=' -v key="$key" -v value="$value" '
        $1 == key { print key "=" value; found = 1; next }
        { print }
        END { if (!found) print key "=" value }
    ' "$dir/meta" > "$tmp" || return 1
    chmod 600 "$tmp" 2>/dev/null || true
    mv "$tmp" "$dir/meta"
}

load_session_status() {
    local status_file="$1" key value

    STATUS_STATE=""
    STATUS_ATTEMPT=""
    STATUS_PID=""
    [[ -r "$status_file" ]] || return 1

    while IFS='=' read -r key value; do
        case "$key" in
            state) STATUS_STATE="$value" ;;
            attempt) STATUS_ATTEMPT="$value" ;;
            pid) STATUS_PID="$value" ;;
        esac
    done < "$status_file"

    [[ -n "$STATUS_STATE" ]]
}

write_session_status() {
    local dir="$1" state="$2" attempt="$3" next_retry="$4" pid="$5" tmp
    tmp="$dir/status.tmp"

    {
        printf 'state=%s\n' "$state"
        printf 'attempt=%s\n' "$attempt"
        printf 'next_retry=%s\n' "$next_retry"
        printf 'pid=%s\n' "$pid"
        printf 'updated=%s\n' "$(date +%s)"
    } > "$tmp"
    chmod 600 "$tmp" 2>/dev/null || true
    mv "$tmp" "$dir/status"
}

session_signature() {
    local dir="$1" line prev=""

    while IFS= read -r line; do
        if [[ "$prev" == "-L" ]]; then
            printf '%s\n' "$line"
            return 0
        fi
        prev="$line"
    done < "$dir/forwards"
    return 1
}

session_is_alive() {
    local pid="$1" dir="$2" command_line

    [[ -n "$pid" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [[ -d "$dir" ]] || return 1

    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$command_line" == *"--supervise"* && "$command_line" == *"$dir"* ]]
}

ssh_session_is_alive() {
    local pid="$1" dir="$2" command_line signature

    [[ -n "$pid" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    signature="$(session_signature "$dir")" || return 1
    [[ -n "$signature" ]] || return 1

    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$command_line" == *ssh* && "$command_line" == *"$signature"* && "$command_line" == *"$SESSION_HOST"* ]]
}

session_ports_available() {
    local dir="$1" line prev="" bind local_port target_host remote_port

    prev=""
    while IFS= read -r line; do
        if [[ "$prev" == "-L" ]]; then
            IFS=: read -r bind local_port target_host remote_port <<< "$line"
            is_port_available "$local_port" || return 1
        fi
        prev="$line"
    done < "$dir/forwards"
    return 0
}

format_uptime() {
    local seconds="$1"

    (( seconds < 0 )) && seconds=0
    if (( seconds >= 86400 )); then
        printf '%dd %02dh' "$((seconds / 86400))" "$(((seconds % 86400) / 3600))"
    elif (( seconds >= 3600 )); then
        printf '%dh %02dm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
    elif (( seconds >= 60 )); then
        printf '%dm %02ds' "$((seconds / 60))" "$((seconds % 60))"
    else
        printf '%ds' "$seconds"
    fi
}

resolve_session_id() {
    local wanted="$1" root dir base matched="" count=0

    [[ "$wanted" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
    [[ "$wanted" != "." && "$wanted" != ".." ]] || return 1

    root="$(farward_state_root)"
    dir="$root/$wanted"
    if [[ -d "$dir" ]]; then
        printf '%s\n' "$wanted"
        return 0
    fi

    for dir in "$root"/*; do
        [[ -d "$dir" ]] || continue
        base="${dir##*/}"
        if [[ "$base" == "$wanted"* ]]; then
            matched="$base"
            count=$((count + 1))
        fi
    done

    (( count == 1 )) || return 1
    printf '%s\n' "$matched"
}

resolve_or_fail() {
    local wanted="$1" resolved

    if ! resolved="$(resolve_session_id "$wanted")"; then
        fail "No unique session matches '$wanted'. Run: farward list"
    fi
    SESSION_RESOLVED="$resolved"
}

terminate_session() {
    local pid="$1" dir="$2" waited=0

    session_is_alive "$pid" "$dir" || return 1

    kill "$pid" 2>/dev/null || true
    while (( waited < 30 )) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        waited=$((waited + 1))
    done
    if session_is_alive "$pid" "$dir"; then
        kill -9 "$pid" 2>/dev/null || true
        sleep 0.1
    fi
    return 0
}

terminate_ssh_child() {
    local pid="$1" dir="$2" waited=0

    ssh_session_is_alive "$pid" "$dir" || return 1

    kill "$pid" 2>/dev/null || true
    while (( waited < 30 )) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        waited=$((waited + 1))
    done
    if ssh_session_is_alive "$pid" "$dir"; then
        kill -9 "$pid" 2>/dev/null || true
        sleep 0.1
    fi
    return 0
}

stop_one_session() {
    local id="$1" dir

    [[ -n "$id" ]] || fail "No such session: $id"
    dir="$(farward_state_root)/$id"
    [[ -d "$dir" ]] || fail "No such session: $id"

    if load_session_meta "$dir/meta"; then
        if terminate_session "$SESSION_PID" "$dir"; then
            printf 'Stopped session %s.\n' "$id"
        else
            printf 'Session %s was not running; cleaning up state.\n' "$id"
        fi
        terminate_ssh_child "$SESSION_SSH_PID" "$dir" || true
    else
        printf 'Session %s had no readable state; removing it.\n' "$id"
    fi

    rm -rf "$dir"
}

run_session_list() {
    local root dir id forwards status uptime now found=0

    root="$(farward_state_root)"
    if [[ -d "$root" ]]; then
        for dir in "$root"/*; do
            [[ -d "$dir" ]] || continue
            found=1
            break
        done
    fi

    if (( found == 0 )); then
        printf 'No background sessions.\n'
        return 0
    fi

    printf '%-26s %-16s %-10s %-7s %s\n' "ID" "HOST" "UPTIME" "STATUS" "FORWARDS"
    now="$(date +%s)"
    for dir in "$root"/*; do
        [[ -d "$dir" ]] || continue
        id="${dir##*/}"
        if ! load_session_meta "$dir/meta"; then
            printf '%-26s %-16s %-10s %-7s %s\n' "$id" "?" "-" "invalid" "0"
            continue
        fi

        forwards="$(grep -c '^-L$' "$dir/forwards" 2>/dev/null || true)"
        [[ -n "$forwards" ]] || forwards=0

        load_session_status "$dir/status" || true
        if session_is_alive "$SESSION_PID" "$dir"; then
            case "$STATUS_STATE" in
                connecting) status="starting" ;;
                reconnecting) status="retry-${STATUS_ATTEMPT:-?}" ;;
                failed) status="failed" ;;
                *) status="alive" ;;
            esac
        elif [[ "$STATUS_STATE" == "failed" ]]; then
            status="failed"
        else
            status="stale"
        fi

        if [[ "$SESSION_STARTED" =~ ^[0-9]+$ ]]; then
            uptime="$(format_uptime "$((now - SESSION_STARTED))")"
        else
            uptime="-"
        fi

        printf '%-26s %-16s %-10s %-7s %s\n' "$id" "$SESSION_HOST" "$uptime" "$status" "$forwards"
    done
}

run_session_stop() {
    local all=false arg id="" root dir found=0

    for arg in "$@"; do
        case "$arg" in
            --all) all=true ;;
            -h|--help) usage; return 0 ;;
            -*) fail "Unknown option for stop: $arg" ;;
            *)
                [[ -z "$id" ]] || fail "farward stop accepts one session id or --all."
                id="$arg"
                ;;
        esac
    done

    root="$(farward_state_root)"
    if [[ "$all" == true ]]; then
        if [[ -d "$root" ]]; then
            for dir in "$root"/*; do
                [[ -d "$dir" ]] || continue
                stop_one_session "${dir##*/}"
                found=$((found + 1))
            done
        fi
        (( found > 0 )) || printf 'No background sessions.\n'
        return 0
    fi

    [[ -n "$id" ]] || fail "farward stop requires a session id or --all."
    resolve_or_fail "$id"
    stop_one_session "$SESSION_RESOLVED"
}

run_session_logs() {
    local follow=false arg id="" dir

    for arg in "$@"; do
        case "$arg" in
            -f|--follow) follow=true ;;
            -h|--help) usage; return 0 ;;
            -*) fail "Unknown option for logs: $arg" ;;
            *)
                [[ -z "$id" ]] || fail "farward logs accepts one session id."
                id="$arg"
                ;;
        esac
    done

    [[ -n "$id" ]] || fail "farward logs requires a session id."
    resolve_or_fail "$id"
    id="$SESSION_RESOLVED"
    dir="$(farward_state_root)/$id"
    [[ -f "$dir/log" ]] || fail "No log file for session $id."

    if [[ "$follow" == true ]]; then
        tail -f "$dir/log"
    else
        cat "$dir/log"
    fi
}

process_running() {
    local pid="$1" state

    [[ -n "$pid" ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    state="$(ps -p "$pid" -o stat= 2>/dev/null || true)"
    [[ -n "$state" && "$state" != *Z* ]]
}

log_tail() {
    local file="$1"

    [[ -s "$file" ]] || return 0
    tail -n 20 "$file"
}

wait_for_supervisor_connection() {
    local dir="$1" pid="$2" waited=0

    while (( waited < 100 )); do
        process_running "$pid" || return 1
        if load_session_status "$dir/status"; then
            case "$STATUS_STATE" in
                connected)
                    [[ -n "$STATUS_PID" ]] && kill -0 "$STATUS_PID" 2>/dev/null && return 0
                    ;;
                failed)
                    return 1
                    ;;
            esac
        fi
        sleep 0.1
        waited=$((waited + 1))
    done
    return 1
}

launch_managed_session() {
    local dir="$1" host="$2" arg spec prev bind local_port target_host remote_port self

    command_exists nohup || fail "nohup is required for background tunnels."
    self="$(script_path)" || fail "Could not determine the Farward executable path."
    [[ -x "$self" ]] || fail "Farward is not executable at $self."

    SSH_LOG="$dir/log"
    SSH_LOG_PERSIST=true

    nohup "$self" --supervise "$dir" >/dev/null 2>>"$dir/log" &
    MANAGED_PID=$!

    if ! wait_for_supervisor_connection "$dir" "$MANAGED_PID"; then
        fail "Supervisor could not establish the selected forwards:
$(log_tail "$dir/log")"
    fi

    prev=""
    while IFS= read -r spec; do
        if [[ "$prev" == "-L" ]]; then
            IFS=: read -r bind local_port target_host remote_port <<< "$spec"
            probe_forward_target "$local_port" "$bind" "$target_host" "$remote_port"
        fi
        prev="$spec"
    done < "$dir/forwards"
}

# shellcheck disable=SC2329 # invoked by trap
supervisor_shutdown() {
    local dir="${SUPERVISOR_DIR:-}"

    trap - INT TERM HUP

    if [[ -n "${SUPERVISOR_SSH_PID:-}" ]] && process_running "$SUPERVISOR_SSH_PID"; then
        kill "$SUPERVISOR_SSH_PID" 2>/dev/null || true
        wait "$SUPERVISOR_SSH_PID" 2>/dev/null || true
    fi
    SUPERVISOR_SSH_PID=""

    if [[ -n "$dir" && -d "$dir" ]]; then
        write_session_status "$dir" stopped 0 0 "" || true
        update_meta_field "$dir" ssh_pid "" || true
    fi
    exit 0
}

# Waits for the SSH child, but exits early if its session directory disappears
# (for example a manual rm -rf) so a supervising process cannot become an
# untracked background daemon. Returns 2 when the state is gone.
wait_for_ssh_child() {
    local pid="$1" dir="$2" state

    while :; do
        state="$(ps -p "$pid" -o stat= 2>/dev/null || true)"
        [[ -n "$state" && "$state" != *Z* ]] || break
        if [[ ! -d "$dir" || ! -f "$dir/meta" ]]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 2
        fi
        sleep 1
    done
    wait "$pid" 2>/dev/null || true
    return 0
}

run_session_supervisor() {
    local dir="$1" arg spec prev bind local_port target_host remote_port
    local launch_args=()
    local launch_forwards=()
    local retries attempt=0 delay=1 started child_rc

    [[ -d "$dir" ]] || fail "No such session directory: $dir"
    [[ -f "$dir/args" && -f "$dir/forwards" ]] ||
        fail "Session state is incomplete: $dir"
    SUPERVISOR_DIR="$dir"
    trap 'supervisor_shutdown' INT TERM HUP
    trap - EXIT

    load_session_meta "$dir/meta" || fail "Session state is unreadable: $dir"
    retries="$SESSION_RETRIES"
    update_meta_field "$dir" pid "$$" || true

    while IFS= read -r arg; do
        launch_args+=("$arg")
    done < "$dir/args"
    while IFS= read -r arg; do
        launch_forwards+=("$arg")
    done < "$dir/forwards"

    while :; do
        if [[ ! -d "$dir" || ! -f "$dir/meta" ]]; then
            exit 0
        fi

        if ! session_ports_available "$dir"; then
            printf '%s supervisor: a local forward port is already in use; treating attempt %s as failed\n' \
                "$(date)" "$attempt" >>"$dir/log"
        else
            write_session_status "$dir" connecting "$attempt" 0 ""
            ssh "${launch_args[@]}" -n -N "${launch_forwards[@]}" "$SESSION_HOST" \
                >>"$dir/log" 2>&1 &
            SUPERVISOR_SSH_PID=$!
            update_meta_field "$dir" ssh_pid "$SUPERVISOR_SSH_PID" || true
            write_session_status "$dir" connected "$attempt" 0 "$SUPERVISOR_SSH_PID" || true

            started="$(date +%s)"
            wait_for_ssh_child "$SUPERVISOR_SSH_PID" "$dir"
            child_rc=$?
            SUPERVISOR_SSH_PID=""
            if (( child_rc == 2 )); then
                exit 0
            fi
            update_meta_field "$dir" ssh_pid "" || true

            if (( $(date +%s) - started >= 30 )); then
                attempt=0
                delay=1
            fi
        fi

        if [[ "$retries" != "-1" ]] && (( attempt >= retries )); then
            printf '%s supervisor: giving up after %s retries\n' "$(date)" "$attempt" >>"$dir/log"
            write_session_status "$dir" failed "$attempt" 0 "" || true
            exit 1
        fi

        attempt=$((attempt + 1))
        next=$(( $(date +%s) + delay ))
        write_session_status "$dir" reconnecting "$attempt" "$next" "" || true
        printf '%s supervisor: reconnecting in %ss (attempt %s)\n' \
            "$(date)" "$delay" "$attempt" >>"$dir/log"
        sleep "$delay"
        delay=$((delay * 2))
        (( delay > 30 )) && delay=30
    done
}

run_session_restart() {
    local arg id="" root dir spec prev local_port waited
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage; return 0 ;;
            -*) fail "Unknown option for restart: $arg" ;;
            *)
                [[ -z "$id" ]] || fail "farward restart accepts one session id."
                id="$arg"
                ;;
        esac
    done

    [[ -n "$id" ]] || fail "farward restart requires a session id."
    resolve_or_fail "$id"
    id="$SESSION_RESOLVED"
    root="$(farward_state_root)"
    dir="$root/$id"
    [[ -f "$dir/args" && -f "$dir/forwards" ]] ||
        fail "Session $id is missing saved arguments and cannot be restarted."
    load_session_meta "$dir/meta" || fail "Session $id has no readable state."

    terminate_session "$SESSION_PID" "$dir" || true
    terminate_ssh_child "$SESSION_SSH_PID" "$dir" || true

    prev=""
    while IFS= read -r spec; do
        if [[ "$prev" == "-L" ]]; then
            IFS=: read -r _bind local_port _target_port _rest <<< "$spec"
            waited=0
            while (( waited < 20 )) && ! is_port_available "$local_port"; do
                sleep 0.1
                waited=$((waited + 1))
            done
            is_port_available "$local_port" ||
                fail "Local port $local_port is still in use; cannot restart session $id."
        fi
        prev="$spec"
    done < "$dir/forwards"

    rm -f "$dir/status" "$dir/status.tmp"
    printf '\n--- restarted %s ---\n' "$(date)" >> "$dir/log"
    write_session_meta "$dir" "$id" "" "$SESSION_HOST" "$SESSION_BIND" "$SESSION_RETRIES"
    launch_managed_session "$dir" "$SESSION_HOST"

    printf 'Session %s restarted on %s.\n' "$id" "$SESSION_HOST"
    while IFS= read -r spec; do
        [[ "$spec" == -* ]] || printf '  %s\n' "$spec"
    done < "$dir/forwards"

    disown "$MANAGED_PID" 2>/dev/null || true
    MANAGED_PID=""
    SSH_PID=""
    SSH_LOG=""
    SSH_LOG_PERSIST=false
    SESSION_DIR_PENDING=false
    trap - EXIT
}

# Running Farward without a destination is intentionally non-destructive:
# show help instead of guessing a host or attempting an SSH connection.
if (( $# == 0 )); then
    usage
    exit 0
fi

case "$1" in
    --supervise)
        [[ $# -ge 2 ]] || fail "--supervise requires a session directory."
        run_session_supervisor "$2"
        trap - EXIT
        exit 0
        ;;
    list|sessions)
        shift
        run_session_list "$@"
        trap - EXIT
        exit 0
        ;;
    stop)
        shift
        run_session_stop "$@"
        trap - EXIT
        exit 0
        ;;
    logs)
        shift
        run_session_logs "$@"
        trap - EXIT
        exit 0
        ;;
    restart)
        shift
        run_session_restart "$@"
        trap - EXIT
        exit $?
        ;;
esac

while (($#)); do
    case "$1" in
        -p|--port)
            [[ $# -ge 2 ]] || fail "--port requires REMOTE or REMOTE:LOCAL."
            MANUAL_SPECS+=("$2")
            shift 2
            ;;
        -t|--target-host)
            [[ $# -ge 2 ]] || fail "--target-host requires a host name or IPv4 address."
            TARGET_HOST="$2"
            TARGET_HOST_EXPLICIT=true
            shift 2
            ;;
        -m|--manual)
            MANUAL_ONLY=true
            DISCOVER_DOCKER=false
            shift
            ;;
        --no-docker)
            DISCOVER_DOCKER=false
            shift
            ;;
        --scan|--listeners)
            SCAN=true
            SCAN_FLAG=true
            shift
            ;;
        --no-scan)
            NO_SCAN=true
            shift
            ;;
        --exclude)
            [[ $# -ge 2 ]] || fail "--exclude requires a port number."
            validate_port_number "$2" || fail "--exclude '$2' is invalid; use a number from 1 to 65535."
            EXCLUDE_PORTS+="$2|"
            shift 2
            ;;
        -b|--background)
            BACKGROUND=true
            shift
            ;;
        -o|--open)
            OPEN_BROWSER=true
            shift
            ;;
        --retry)
            [[ $# -ge 2 ]] || fail "--retry requires a non-negative integer."
            [[ "$2" =~ ^[0-9]+$ ]] || fail "--retry '$2' is invalid; use a non-negative integer."
            RETRY_LIMIT="$2"
            RETRY_FLAG=true
            shift 2
            ;;
        --retry-forever)
            RETRY_LIMIT=-1
            RETRY_FLAG=true
            shift
            ;;
        --diagnose)
            DIAGNOSE=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --self-test)
            SELF_TEST=true
            shift
            ;;
        -v|--version)
            printf '%s %s\n' "$PROGRAM_NAME" "$FARWARD_VERSION"
            exit 0
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            fail "Unknown option: $1"
            ;;
        *)
            SSH_HOST="$1"
            shift
            ;;
    esac
done

if [[ "$MANUAL_ONLY" == true && "$SCAN_FLAG" == true ]]; then
    fail "--manual and --scan are mutually exclusive; use --no-docker --scan."
fi

if [[ "$RETRY_FLAG" == true && "$BACKGROUND" != true ]]; then
    printf 'Note: auto-reconnect applies to --background sessions; this run will not reconnect.\n'
fi

if [[ "$SELF_TEST" == true ]]; then
    run_self_test
    trap - EXIT
    exit 0
fi

command_exists ssh || fail "ssh is required."
validate_target_host "$TARGET_HOST" || fail "Target host '$TARGET_HOST' is invalid; use a hostname or IPv4 address containing only letters, numbers, dots, underscores, and hyphens."
validate_bind_host "$LOCAL_BIND_HOST" || fail "Local bind host '$LOCAL_BIND_HOST' is invalid; use localhost, 127.0.0.1, or another IPv4 address."
ssh_common_args=()
if [[ -n "${FARWARD_SSH_CONFIG:-}" ]]; then
    [[ -r "$FARWARD_SSH_CONFIG" ]] || fail "FARWARD_SSH_CONFIG '$FARWARD_SSH_CONFIG' is not readable."
    ssh_common_args=(-F "$FARWARD_SSH_CONFIG")
fi
if [[ "$MANUAL_ONLY" != true ]] && { [[ "$DISCOVER_DOCKER" == true ]] || [[ "$SCAN" == true ]]; }; then
    command_exists fzf || fail "fzf is required for the selector. Install it with: brew install fzf  OR  sudo apt install fzf"
fi

printf 'Checking %s...\n' "$SSH_HOST"

selection_rows=""
if [[ "$DISCOVER_DOCKER" == true ]]; then
    docker_status=0
    if remote_output="$(
        ssh_command \
            -o BatchMode=yes \
            -o ConnectTimeout=8 \
            "$SSH_HOST" \
            "docker ps --format '{{.Names}}|{{.Ports}}'" 2>&1
    )"; then
        docker_status=0
    else
        docker_status=$?
    fi

    if (( docker_status != 0 )); then
        printf 'Docker discovery failed on %s: %s\n' "$SSH_HOST" "$(printf '%s' "$remote_output" | head -n 1)" >&2
    fi

    if (( docker_status == 0 )) && [[ -n "$remote_output" ]]; then
        ports="$(
            printf '%s\n' "$remote_output" |
            awk -F'|' '
            function target_for(host) {
                gsub(/^\[/, "", host)
                gsub(/\]$/, "", host)
                if (host == "" || host == "0.0.0.0" || host == "::" || host == ":::" || host == "*") {
                    return "localhost"
                }
                if (host ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
                    return host
                }
                return "localhost"
            }

            {
                container = $1
                mappings = $2

                while (match(mappings, /(([0-9a-fA-F:.]+):)?[0-9]+->[0-9]+\/(tcp|udp)/)) {
                    mapping = substr(mappings, RSTART, RLENGTH)
                    host_side = mapping
                    protocol = mapping
                    sub(/^.*\//, "", protocol)

                    split(mapping, arrow, "->")
                    host_side = arrow[1]
                    container_side = arrow[2]

                    host_bind = host_side
                    sub(/:[^:]*$/, "", host_bind)
                    sub(/^.*:/, "", host_side)
                    sub(/\/.*/, "", container_side)

                    printf "%s\t%s\t%s\t%s\t%s\n", container, host_side, container_side, protocol, target_for(host_bind)
                    mappings = substr(mappings, RSTART + RLENGTH)
                }
            }' |
            sort -t $'\t' -k1,1 -k2,2n -k5,5 -u
        )"
        if [[ -n "$ports" ]]; then
            selection_rows="$(
                printf '%s\n' "$ports" |
                awk -F'\t' -v exclude="$EXCLUDE_PORTS" '{
                    if (index(exclude, "|" $2 "|") > 0) next
                    target_note = ($5 == "localhost" ? "" : " bind:" $5)
                    printf "D %-28s host:%-6s container:%-6s %s%s\t%s\t%s\t%s\t__AUTO__\t%s\n", $1, $2, $3, $4, target_note, $2, $3, $4, $5
                }'
            )"
        fi
    fi
fi

if [[ "$DISCOVER_DOCKER" == true && "$SCAN" != true && "$NO_SCAN" != true && "$MANUAL_ONLY" != true && -z "$selection_rows" ]]; then
    printf 'No published Docker ports found; scanning remote listeners...\n'
    SCAN=true
fi

if [[ "$SCAN" == true ]]; then
    append_scan_rows
fi

if ((${#MANUAL_SPECS[@]} > 0)); then
    for spec in "${MANUAL_SPECS[@]}"; do
        parsed="$(parse_manual_spec "$spec")"
        IFS=$'\t' read -r label remote_port _kind protocol local_override <<< "$parsed"
        append_selection_row "$(format_manual_row "$label" "$remote_port" "$local_override")"
    done
fi

if [[ "$MANUAL_ONLY" == true ]]; then
    selection=""
    while manual_row="$(prompt_manual_port)"; do
        remote_port="$(printf '%s' "$manual_row" | cut -f2)"
        selection+="$(format_manual_row "${manual_row%%$'\t'*}" "$remote_port")"$'\n'
    done
    [[ -n "$selection" ]] || exit 0
elif [[ "$DISCOVER_DOCKER" != true && "$SCAN" != true ]]; then
    selection="$selection_rows"
    while [[ -z "$selection" ]] && manual_row="$(prompt_manual_port)"; do
        remote_port="$(printf '%s' "$manual_row" | cut -f2)"
        selection+="$(format_manual_row "${manual_row%%$'\t'*}" "$remote_port")"$'\n'
    done
    [[ -n "$selection" ]] || exit 0
else
    while true; do
        selector_rows="$selection_rows"
        if [[ -n "$selector_rows" && "$selector_rows" != *$'\n' ]]; then
            selector_rows+=$'\n'
        fi
        selector_rows+="$(format_add_manual_row)"

        selection="$(
            printf '%s\n' "$selector_rows" |
            fzf \
                --multi \
                --delimiter=$'\t' \
                --with-nth=1 \
                --prompt='Forward ports > ' \
                --header='TAB selects multiple ports · choose [add custom port] to add standalone services' \
                --height=80% \
                --border
        )" || exit 0
        [[ -n "$selection" ]] || exit 0

        if ! grep -q $'\t__ADD_MANUAL__\t' <<< "$selection"; then
            break
        fi

        selection="$(printf '%s\n' "$selection" | grep -v $'\t__ADD_MANUAL__\t' || true)"
        added_selection=""
        while manual_row="$(prompt_manual_port)"; do
            remote_port="$(printf '%s' "$manual_row" | cut -f2)"
            manual_selection="$(format_manual_row "manual:$remote_port" "$remote_port")"
            append_selection_row "$manual_selection"
            added_selection+="$manual_selection"$'\n'
            printf 'Add another manual port? [y/N]: ' >/dev/tty
            IFS= read -r again </dev/tty
            [[ "$again" =~ ^[Yy]$ ]] || break
        done

        if [[ -n "$added_selection" ]]; then
            if [[ -n "$selection" ]]; then
                selection+=$'\n'"$added_selection"
            else
                selection="$added_selection"
            fi
            break
        fi
    done
    [[ -n "$selection" ]] || exit 0
fi

forward_args=()
summary=()
urls=()
probe_specs=()
used_local_ports="|"

while IFS=$'\t' read -r display remote_port container_port protocol local_override target_override; do
    [[ -n "${display}${remote_port}${container_port}${protocol}${local_override:-}${target_override:-}" ]] || continue
    [[ "${local_override:-}" != "__AUTO__" ]] || local_override=""
    [[ "${target_override:-}" != "__DEFAULT__" ]] || target_override=""

    [[ "$protocol" == "tcp" ]] || {
        printf 'Skipping UDP port %s; SSH local forwarding supports TCP only.\n' "$remote_port" >&2
        continue
    }

    if [[ "$TARGET_HOST_EXPLICIT" == true || -z "${target_override:-}" ]]; then
        target_host="$TARGET_HOST"
    else
        target_host="$target_override"
    fi
    validate_target_host "$target_host" || fail "Target host '$target_host' is invalid; use a hostname or IPv4 address containing only letters, numbers, dots, underscores, and hyphens."

    if [[ -n "${local_override:-}" ]]; then
        preferred_port="$local_override"
    else
        preferred_port="$(preferred_local_port "$remote_port")"
    fi
    if [[ -n "${local_override:-}" ]]; then
        suggested_port="$preferred_port"
    else
        suggested_port="$(next_available_port "$preferred_port")"
    fi
    local_port="$suggested_port"

    while true; do
        if [[ -z "${local_override:-}" && -t 0 && -r /dev/tty && -w /dev/tty ]]; then
            if (( remote_port < 1024 )); then
                printf 'Remote port %s cannot normally bind to the same local port without elevated privileges.\n' "$remote_port"
            fi
            printf 'Local port for remote %s [%s]: ' "$remote_port" "$suggested_port"
            IFS= read -r entered_port </dev/tty
            local_port="${entered_port:-$suggested_port}"
        fi

        if [[ ! "$local_port" =~ ^[0-9]+$ ]] || (( local_port < 1 || local_port > 65535 )); then
            if [[ -z "${local_override:-}" && -t 0 && -r /dev/tty && -w /dev/tty ]]; then
                printf 'Port "%s" is invalid. Enter a number between 1 and 65535.\n' "$local_port" >&2
                local_port=""
                continue
            fi
            fail "Invalid local port: $local_port"
        fi

        if (( local_port < 1024 )) && [[ "$(id -u)" -ne 0 ]]; then
            suggested_port="$(next_available_port "$(preferred_local_port "$remote_port")")"
            if [[ -z "${local_override:-}" && -t 0 && -r /dev/tty && -w /dev/tty ]]; then
                printf 'Local port %s is blocked for normal users. Choose an alternative; suggested: %s.\n'                     "$local_port" "$suggested_port" >&2
                local_port=""
                continue
            fi
            fail "Local port $local_port is privileged."
        fi

        if ! is_port_available "$local_port"; then
            suggested_port="$(next_available_port "$((local_port + 1))")"
            if [[ -z "${local_override:-}" && -t 0 && -r /dev/tty && -w /dev/tty ]]; then
                printf 'Local port %s is already in use. Choose an alternative; suggested: %s.\n'                     "$local_port" "$suggested_port" >&2
                local_port=""
                continue
            fi
            fail "Local port $local_port is already in use."
        fi

        break
    done

    if [[ "$used_local_ports" == *"|${local_port}|"* ]]; then
        fail "Local port $local_port was selected more than once in this Farward session."
    fi
    used_local_ports+="${local_port}|"

    forward_args+=("-L" "${LOCAL_BIND_HOST}:${local_port}:${target_host}:${remote_port}")
    probe_specs+=("${LOCAL_BIND_HOST}|${local_port}|${target_host}|${remote_port}")
    if [[ "$target_host" == "127.0.0.1" || "$target_host" == "localhost" ]]; then
        summary+=("${LOCAL_BIND_HOST}:${local_port}|${SSH_HOST}:${remote_port}")
    else
        summary+=("${LOCAL_BIND_HOST}:${local_port}|${target_host}:${remote_port} via ${SSH_HOST}")
    fi

    browser_port="$container_port"
    [[ "$container_port" == "manual" ]] && browser_port="$remote_port"
    case "$browser_port" in
        80|443|3000|4173|5000|5173|8000|8080|8025|7700)
            if [[ "$browser_port" == "443" ]]; then
                urls+=("https://${LOCAL_BIND_HOST}:${local_port}")
            else
                urls+=("http://${LOCAL_BIND_HOST}:${local_port}")
            fi
            ;;
    esac
done <<< "$selection"

((${#forward_args[@]} > 0)) || fail "No TCP ports were selected."

ssh_args=()
if ((${#ssh_common_args[@]} > 0)); then
    ssh_args+=("${ssh_common_args[@]}")
fi
ssh_args+=(
    -o ExitOnForwardFailure=yes
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
    -o TCPKeepAlive=yes
)

if [[ "$DIAGNOSE" == true ]]; then
    diagnose_failed=false
    for spec in "${probe_specs[@]}"; do
        IFS='|' read -r _probe_bind_host _probe_local_port probe_target_host probe_remote_port <<< "$spec"
        diagnose_remote_target "$probe_target_host" "$probe_remote_port" || diagnose_failed=true
    done
    [[ "$diagnose_failed" != true ]] || fail "One or more remote targets are not reachable from $SSH_HOST."
    printf 'All remote targets are reachable from %s.\n' "$SSH_HOST"
    trap - EXIT
    exit 0
fi

if [[ "$DRY_RUN" == true ]]; then
    printf '\nResolved forwards:\n'
    for item in "${summary[@]}"; do
        printf '  %s -> %s\n' "${item%%|*}" "${item#*|}"
    done
    printf '\nSSH arguments:\n'
    printf '  ssh'
    for arg in "${ssh_args[@]:-}"; do
        printf ' %q' "$arg"
    done
    for arg in "${forward_args[@]}"; do
        printf ' %q' "$arg"
    done
    printf ' %q\n' "$SSH_HOST"
    trap - EXIT
    exit 0
fi

if [[ "$BACKGROUND" == true ]]; then
    command_exists nohup || fail "nohup is required for background tunnels."

    state_root="$(farward_state_root)"
    mkdir -p "$state_root" 2>/dev/null || fail "Could not create session state directory: $state_root"
    chmod 700 "$state_root" 2>/dev/null || true

    session_id="$(new_session_id)"
    session_dir="$state_root/$session_id"
    while ! mkdir "$session_dir" 2>/dev/null; do
        session_id="$(new_session_id)"
        session_dir="$state_root/$session_id"
    done
    chmod 700 "$session_dir" 2>/dev/null || true
    SESSION_DIR_PENDING=true
    SESSION_DIR="$session_dir"

    session_args=("${ssh_args[@]}")
    printf '%s\n' "${session_args[@]}" >"$session_dir/args"
    printf '%s\n' "${forward_args[@]}" >"$session_dir/forwards"
    : >"$session_dir/log"
    chmod 600 "$session_dir/args" "$session_dir/forwards" "$session_dir/log" 2>/dev/null || true
    write_session_meta "$session_dir" "$session_id" "" "$SSH_HOST" "$LOCAL_BIND_HOST" "$RETRY_LIMIT"

    launch_managed_session "$session_dir" "$SSH_HOST"

    if [[ "$OPEN_BROWSER" == true ]]; then
        for url in "${urls[@]}"; do
            open_url "$url"
        done
    fi

    printf '\nTunnel started in the background.\n'
    printf 'Session: %s\n' "$session_id"
    printf 'Host: %s\n' "$SSH_HOST"
    for item in "${summary[@]}"; do
        printf '  %s → %s\n' "${item%%|*}" "${item#*|}"
    done
    printf '\nManage it with:\n'
    printf '  farward list\n'
    printf '  farward logs %s\n' "$session_id"
    printf '  farward restart %s\n' "$session_id"
    printf '  farward stop %s\n' "$session_id"

    SESSION_DIR_PENDING=false
    disown "$MANAGED_PID" 2>/dev/null || true
    MANAGED_PID=""
    SSH_PID=""
    SSH_LOG=""
    SSH_LOG_PERSIST=false
    trap - EXIT
    exit 0
fi

if [[ ! -t 1 || ! -r /dev/tty || ! -w /dev/tty ]]; then
    fail "Foreground dashboard requires a terminal. Use --background for non-interactive runs."
fi

printf '\nStarting SSH tunnel...\n'
for item in "${summary[@]}"; do
    printf '  %s → %s\n' "${item%%|*}" "${item#*|}"
done
printf '\n'

SSH_LOG="$(mktemp -t farward-ssh.XXXXXX)"
ssh "${ssh_args[@]}" -n -N "${forward_args[@]}" "$SSH_HOST" 2>"$SSH_LOG" &
SSH_PID=$!

sleep 0.5
if ! kill -0 "$SSH_PID" 2>/dev/null; then
    wait "$SSH_PID" || true
    if [[ -s "$SSH_LOG" ]]; then
        fail "SSH could not establish the selected forwards:
$(cat "$SSH_LOG")"
    fi
    fail "SSH could not establish the selected forwards."
fi

for spec in "${probe_specs[@]}"; do
    IFS='|' read -r probe_bind_host probe_local_port probe_target_host probe_remote_port <<< "$spec"
    probe_forward_target "$probe_local_port" "$probe_bind_host" "$probe_target_host" "$probe_remote_port"
done

if [[ "$OPEN_BROWSER" == true ]]; then
    for url in "${urls[@]}"; do
        open_url "$url"
    done
fi

run_dashboard
